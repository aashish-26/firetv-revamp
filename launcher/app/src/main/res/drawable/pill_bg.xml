<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#C3D3E1" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#BF283747" android:endColor="#D5111A25" />
            <stroke android:width="1dp" android:color="#5D90A8BF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
